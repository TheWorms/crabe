# Configuration de crabe — copiez ce fichier en `.env` et adaptez les valeurs.
# Avec Docker Compose, ces variables se posent dans docker-compose.yml ou dans
# un fichier `.env` à côté de lui ; les valeurs ci-dessous sont des exemples.

# ── Indispensables ────────────────────────────────────────────────────────────

# Phrase secrète qui chiffre les identifiants enregistrés. À générer une fois
# (par exemple : openssl rand -base64 32) et à NE JAMAIS PERDRE : sans elle,
# les identifiants chiffrés sont irrécupérables. Laissée vide avec Docker,
# elle est générée au premier démarrage et écrite dans le volume de données.
CRABE_MASTER_PASSPHRASE=changez-moi-phrase-longue-et-privee

# Secret des cookies de session (openssl rand -hex 32). Généré de la même
# façon si absent avec Docker.
CRABE_SESSION_SECRET=changez-moi-aussi

# ── Réseau ────────────────────────────────────────────────────────────────────

# Adresse et port d'écoute de l'application.
CRABE_HOST=0.0.0.0
CRABE_PORT=3000

# Nombre de proxys de confiance devant crabe (0 = accès direct). Ne sert qu'à
# lire l'adresse IP réelle du client dans X-Forwarded-For.
CRABE_TRUST_PROXY=0

# Mettre à 1 si crabe est servi en HTTPS : le cookie de session devient
# « Secure ». En HTTP (défaut auto-hébergé), laissez 0.
CRABE_COOKIE_SECURE=0

# Liste de plages CIDR autorisées, séparées par des virgules. Vide = tout le
# monde. Exemple : 10.0.0.0/24,127.0.0.1/32
CRABE_ALLOWED_CIDRS=

# ── Données ───────────────────────────────────────────────────────────────────

# Répertoire des données (base SQLite, secrets chiffrés, diagnostics).
# Dans le conteneur Docker, c'est /data (le volume déclaré par compose).
CRABE_DATA_DIR=./data

# Racine du stockage local des documents : un dossier du disque ou un point de
# montage (SMB/NFS monté par l'hôte — crabe ne monte rien lui-même).
CRABE_LOCAL_PATH=/data/documents

# Répertoire des diagnostics d'échec (HTML masqué, capture, contexte).
# Défaut : <CRABE_DATA_DIR>/diagnostics
#CRABE_DIAGNOSTICS_DIR=

# ── Compte d'amorçage ─────────────────────────────────────────────────────────

# Identifiant du premier compte administrateur. Sans mot de passe défini,
# c'est l'écran de création de compte qui fait foi au premier démarrage.
CRABE_ADMIN_USERNAME=admin
CRABE_ADMIN_PASSWORD=
CRABE_ADMIN_EMAIL=

# ── Mise à jour ───────────────────────────────────────────────────────────────

# Dépôt GitHub interrogé (une fois par jour au plus) pour signaler qu'une
# nouvelle version existe. Vide = vérification coupée. Jamais de mise à jour
# automatique : crabe affiche une bannière, c'est tout.
# Exemple : proprietaire/crabe
CRABE_UPDATE_REPO=

# ── Outils externes ───────────────────────────────────────────────────────────

# Binaire rclone et fichier de configuration qu'il utilise (destinations cloud).
# Défauts : « rclone » dans le PATH, et <CRABE_DATA_DIR>/rclone.conf
#CRABE_RCLONE_BIN=/usr/bin/rclone
#CRABE_RCLONE_CONF=

# Répertoire de noVNC (navigateur distant). Défaut : détection automatique.
#CRABE_NOVNC_DIR=

# ── Réglages fins (rarement utiles) ───────────────────────────────────────────

# Coupe le planificateur (1 = aucune récupération automatique).
#CRABE_DISABLE_SCHEDULER=0

# Coupe le scraping par navigateur (1 = connecteurs en mode simulé — tests).
#CRABE_DISABLE_SCRAPING=0

# Pause minimale entre deux pages Amazon, en millisecondes (plancher : 5000).
#CRABE_AMAZON_PAUSE_MS=5000

# Délai entre deux copies vers des destinations, en millisecondes.
#CRABE_COPIE_DELAI_MS=
